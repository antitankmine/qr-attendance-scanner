<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1d1d21"
    android:padding="20dp">

    <!-- ADMIN HEADER -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        app:cardBackgroundColor="#D32F2F"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADMIN CONSOLE"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="System Management &amp; Audit Logs"
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>

            <View
                android:layout_width="55dp"
                android:layout_height="4dp"
                android:layout_marginTop="14dp"
                android:background="#1976D2"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>


    <!-- SERVER AND NETWORK CONFIGURATION -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#E0E0E0"
        app:cardCornerRadius="14dp"
        app:cardElevation="3dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYSTEM SETUP"
                android:textColor="#D32F2F"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Network &amp; Security Configuration"
                android:textColor="#181A1D"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="#FFFFFF"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Backend URL: http://10.0.2.2:8080&#10;Trusted Wi-Fi IP Subnet: 192.168.1.0/24&#10;Dynamic QR Refresh: 30 Seconds"
                android:textColor="#181A1D"
                android:textSize="13sp"
                android:lineSpacingExtra="6dp"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>


    <!-- OFFLINE SYNCHRONIZATION -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        app:cardBackgroundColor="#E0E0E0"
        app:cardCornerRadius="14dp"
        app:cardElevation="3dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFFLINE SYNCHRONIZATION"
                android:textColor="#1976D2"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"/>

            <TextView
                android:id="@+id/tvUnsyncedQueueCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Offline Queue: 0 Pending Syncs"
                android:textColor="#181A1D"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnTriggerSync"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:text="SYNC PENDING RECORDS"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="#1976D2"
                app:cornerRadius="10dp"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>


    <!-- AUDIT LOGS HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <View
            android:layout_width="4dp"
            android:layout_height="24dp"
            android:background="#D32F2F"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="SYSTEM AUDIT LOGS"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"/>

    </LinearLayout>


    <!-- AUDIT LOG LIST -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardBackgroundColor="#E0E0E0"
        app:cardCornerRadius="14dp"
        app:cardElevation="3dp"
        app:strokeWidth="0dp">

        <ListView
            android:id="@+id/listViewAuditLogs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:clipToPadding="false"
            android:divider="#FFFFFF"
            android:dividerHeight="1dp"
            android:background="@android:color/transparent"
            android:cacheColorHint="@android:color/transparent"/>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
